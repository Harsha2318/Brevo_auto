# Brevo Email Automation Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# BREVO EMAIL API CONFIGURATION
# ===========================================

# Brevo API Key - Get from https://app.brevo.com/settings/keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/database
MONGO_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/brevo_automation?retryWrites=true&w=majority

# ===========================================
# API ENDPOINTS
# ===========================================

# User Retention API URL (FastAPI server)
USER_RETENTION_API_URL=http://localhost:5000/api/user-retention/emails

# Cohort API Configuration
COHORT_API_URL=http://localhost:5000/api/cohort/admin/cohort-emails

# ===========================================
# AUTHENTICATION
# ===========================================

# Admin token for cohort API access
# Generate a secure JWT token or use API key
ADMIN_TOKEN=your_admin_token_here

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# Google Gemini API (for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Analytics (for tracking)
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Sentry for error tracking
SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (true for development, false for production)
DEBUG=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Host and ports
HOST=0.0.0.0
API_PORT=5000
UI_PORT=8501

# Server workers (for production)
WORKERS=4

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# ===========================================
# SECURITY SETTINGS
# ===========================================

# Secret key for sessions and tokens
SECRET_KEY=your-secret-key-here-change-this-in-production

# Session timeout (seconds)
SESSION_TIMEOUT=3600

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ===========================================
# FILE UPLOAD SETTINGS
# ===========================================

# Maximum file size for uploads (bytes)
MAX_FILE_SIZE=10485760

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=csv,txt,xlsx

# Upload directory
UPLOAD_DIR=temp

# ===========================================
# EMAIL CAMPAIGN SETTINGS
# ===========================================

# Default sender information
DEFAULT_SENDER_NAME=Your Company Name
DEFAULT_SENDER_EMAIL=noreply@yourcompany.com

# Campaign settings
DEFAULT_TIMEZONE=UTC
CAMPAIGN_BATCH_SIZE=1000

# ===========================================
# EXTERNAL API SETTINGS
# ===========================================

# API request timeout
API_TIMEOUT=30

# Retry configuration
API_RETRIES=3
API_RETRY_DELAY=1

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# MONITORING & LOGGING
# ===========================================

# Log file path
LOG_FILE=logs/app.log

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Enable performance monitoring
ENABLE_METRICS=true

# Metrics collection interval (seconds)
METRICS_INTERVAL=60

# ===========================================
# CACHE SETTINGS
# ===========================================

# Redis configuration (optional)
REDIS_URL=redis://localhost:6379

# Cache TTL (seconds)
CACHE_TTL=3600

# Cache enabled
CACHE_ENABLED=true

# ===========================================
# BACKUP SETTINGS
# ===========================================

# Backup directory
BACKUP_DIR=backups

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention (days)
BACKUP_RETENTION=7

# ===========================================
# NOTIFICATION SETTINGS
# ===========================================

# Email notifications
NOTIFICATION_EMAIL=admin@yourcompany.com

# Slack webhook for alerts
SLACK_WEBHOOK=https://hooks.slack.com/services/...

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================

# Enable hot reload
HOT_RELOAD=true

# Development database (separate from production)
DEV_MONGO_URI=mongodb://localhost:27017/brevo_dev

# Test API keys (for development only)
TEST_BREVO_API_KEY=test_key
TEST_ADMIN_TOKEN=test_token

# ===========================================
# PRODUCTION OVERRIDES
# ===========================================

# Production-specific settings (uncomment for production)
# DATABASE_URL=postgresql://user:pass@host:port/db
# REDIS_URL=redis://prod-redis:6379
# CDN_URL=https://cdn.yourcompany.com
# STATIC_URL=https://static.yourcompany.com

# ===========================================
# VALIDATION CHECKLIST
# ===========================================

# Before starting the application, ensure:
# ✅ BREVO_API_KEY is valid and has required permissions
# ✅ MONGO_URI connects to accessible MongoDB instance
# ✅ USER_RETENTION_API_URL points to running FastAPI server
# ✅ COHORT_API_URL is accessible (if using cohort features)
# ✅ ADMIN_TOKEN is valid for cohort API authentication
# ✅ All required directories exist (logs, temp, backups)
# ✅ File permissions are correct
# ✅ No sensitive data is logged

# ===========================================
# SECURITY REMINDERS
# ===========================================

# 🔒 NEVER commit .env files to version control
# 🔒 Rotate API keys regularly
# 🔒 Use strong, unique passwords
# 🔒 Enable 2FA where available
# 🔒 Monitor access logs
# 🔒 Keep dependencies updated
# 🔒 Use HTTPS in production
# 🔒 Implement rate limiting
# 🔒 Validate all inputs
# 🔒 Sanitize database queries

# ===========================================
# SUPPORT INFORMATION
# ===========================================

